NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public GitHub username. Prefer the server-only setting; the public alternative is optional.
GITHUB_USERNAME=
NEXT_PUBLIC_GITHUB_USERNAME=
# Optional. Server-only; never prefix a token with NEXT_PUBLIC_. Only public data is returned.
GITHUB_TOKEN=
# Optional verified contact channels. Empty values are omitted from the UI.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
